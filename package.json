{
  "name": "saas-identity-platform-miniprogram",
  "version": "1.0.0",
  "private": true,
  "description": "xr-code-suite miniprogram profile 脚手架（Phase 0 骨架，零业务）",
  "templateInfo": null,
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "dev:weapp": "npm run build:weapp -- --watch",
    "gate": "cd ../.. && python scripts/gate.py -p saas-identity-platform-miniprogram",
    "test": "vitest run",
    "trace": "TRACE_MAP=1 vitest run",
    "lint": "eslint src tests config",
    "format": "prettier --write src tests config",
    "gen-shared": "openapi-generator-cli generate -i ../saas-identity-platform-shared/generated/openapi/openapi.yaml -g typescript-fetch -o src/generated --additional-properties=hideGenerationTimestamp=true,supportsES6=true",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@tarojs/components": "4.3.0",
    "@tarojs/helper": "4.3.0",
    "@tarojs/plugin-platform-weapp": "4.3.0",
    "@tarojs/react": "4.3.0",
    "@tarojs/runtime": "4.3.0",
    "@tarojs/shared": "4.3.0",
    "@tarojs/taro": "4.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@openapitools/openapi-generator-cli": "^2.41.0",
    "@tarojs/cli": "4.3.0",
    "@tarojs/plugin-framework-react": "4.3.0",
    "@tarojs/webpack5-runner": "4.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "babel-preset-taro": "4.3.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "postcss": "^8.5.31",
    "prettier": "^3.4.0",
    "sass": "^1.105.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^4.0.0",
    "webpack": "^5.91.0"
  }
}
